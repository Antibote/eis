# Пример .env для docker compose (скопируйте в .env и задайте свои значения)
EIS_SECRET_KEY=замените-на-случайную-строку-не-короче-32-символов
EIS_ADMIN_PASSWORD=замените-на-надёжный-пароль
# Локальная LLM (необязательно): Ollama на хосте, слушающая адрес моста docker0
EIS_LLM_PROVIDER=ollama
EIS_LLM_URL=http://host.docker.internal:11434
EIS_LLM_MODEL=qwen2.5:3b
